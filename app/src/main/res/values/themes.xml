<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BelBets" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/brand_teal</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/surface_white</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.BelBets.Launch" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/browser_window_background</item>
        <item name="android:navigationBarColor">@color/browser_window_background</item>
        <item name="android:windowBackground">@color/browser_window_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="FeedWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/feed_fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/feed_fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/feed_fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/feed_fade_out</item>
    </style>

    <style name="Theme.BelBets.Feed" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@style/FeedWindowAnimation</item>
        <item name="android:windowBackground">@color/browser_surface_background</item>
        <item name="android:statusBarColor">@color/browser_surface_background</item>
        <item name="android:navigationBarColor">@color/browser_surface_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.BelBets.Immersive" parent="Theme.BelBets.Feed" />
</resources>
